{
  "name": "xiaochu-local",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm run dev -w @xiaochu/server\" \"npm run dev -w @xiaochu/web\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "e2e": "playwright test",
    "lint": "eslint .",
    "content:validate": "tsx scripts/content/validate-catalog.ts",
    "content:video-health": "tsx scripts/content/video-health.ts",
    "content:convert-mirecipe": "tsx scripts/content/convert-mirecipe.ts",
    "content:build-covers": "tsx scripts/content/build-cover-manifest.ts",
    "content:apply-videos": "tsx scripts/content/apply-video-manifest.ts",
    "start:local": "powershell -ExecutionPolicy Bypass -File ./scripts/start-local.ps1",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@vitest/coverage-v8": "4.1.11",
    "concurrently": "10.0.5",
    "eslint": "10.9.0",
    "tsx": "^4.23.12",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
