{"schemaVersion":1,"sourceKey":"xiaochu:standard:qingchao-shanghaiqing","contentVersion":"2026.08.1","title":"清炒上海青","aliases":["清炒小青菜","蒜香上海青"],"summary":"适合第一次掌握大火快炒的家常青菜，重点是菜梗先下锅、菜叶后下锅。","tier":"standard","difficulty":"easy","servings":2,"prepMinutes":8,"cookMinutes":4,"taste":["清淡","蒜香"],"techniques":["大火快炒"],"tags":["家常菜","快手菜","素菜"],"cover":{"remoteUrl":"https://images.example.com/recipes/qingchao-shanghaiqing.webp","alt":"白瓷盘中的蒜香清炒上海青"},"media":[],"ingredients":[{"canonicalName":"上海青","aliases":["小青菜"],"category":"produce","quantity":300,"unit":"克","optional":false,"note":"菜梗和菜叶分开"},{"canonicalName":"大蒜","aliases":["蒜瓣"],"category":"seasoning","quantity":3,"unit":"瓣","optional":false,"note":"切薄片"},{"canonicalName":"食用油","aliases":[],"category":"seasoning","quantity":15,"unit":"毫升","optional":false},{"canonicalName":"盐","aliases":[],"category":"seasoning","quantity":2,"unit":"克","optional":false}],"steps":[{"number":1,"instruction":"上海青逐片洗净并充分沥水，把较厚的菜梗和菜叶分开放置，大蒜切片。","ingredientNames":["上海青","大蒜"]},{"number":2,"instruction":"炒锅烧热后加入食用油，放入蒜片快速翻动，刚闻到蒜香时立即进行下一步。","ingredientNames":["食用油","蒜瓣"]},{"number":3,"instruction":"先放菜梗大火翻炒约一分钟，再放菜叶和盐，炒至叶片变软且菜梗仍有脆感即可出锅。","ingredientNames":["小青菜","盐"]}]}
{"schemaVersion":1,"sourceKey":"xiaochu:video:fanqie-chaodan","contentVersion":"2026.08.1","title":"番茄炒蛋","aliases":["西红柿炒鸡蛋"],"summary":"用凝固程度和番茄出汁状态判断火候，做出嫩鸡蛋和浓郁酸甜汤汁。","tier":"video","difficulty":"easy","servings":2,"prepMinutes":10,"cookMinutes":8,"taste":["酸甜","鲜香"],"techniques":["滑炒","煸炒"],"tags":["家常菜","下饭菜","新手友好"],"cover":{"remoteUrl":"https://images.example.com/recipes/fanqie-chaodan.webp","alt":"番茄汁包裹嫩鸡蛋的番茄炒蛋"},"media":[{"kind":"html5","url":"https://media.example.com/recipes/fanqie-chaodan.mp4?version=1","provider":"xiaochu-cdn","posterUrl":"https://images.example.com/recipes/fanqie-chaodan-video.webp"}],"ingredients":[{"canonicalName":"番茄","aliases":["西红柿"],"category":"produce","quantity":2,"unit":"个","optional":false,"note":"约四百克，切滚刀块"},{"canonicalName":"鸡蛋","aliases":[],"category":"meat_egg_dairy","quantity":3,"unit":"个","optional":false,"note":"打散至蛋清蛋黄完全融合"},{"canonicalName":"食用油","aliases":[],"category":"seasoning","quantity":25,"unit":"毫升","optional":false},{"canonicalName":"盐","aliases":[],"category":"seasoning","quantity":3,"unit":"克","optional":false},{"canonicalName":"白砂糖","aliases":["糖"],"category":"seasoning","quantity":4,"unit":"克","optional":true}],"steps":[{"number":1,"instruction":"番茄去蒂切成大小接近的滚刀块，鸡蛋加一克盐充分打散。","ingredientNames":["番茄","鸡蛋","盐"],"durationSecondsMin":60,"durationSecondsMax":120},{"number":2,"instruction":"锅烧热后加入十五毫升油，倒入蛋液，中火推炒至约八成凝固，仍有少量湿润光泽时盛出。","ingredientNames":["食用油","鸡蛋"],"durationSecondsMin":35,"durationSecondsMax":55,"heatOrDevice":"燃气灶中火"},{"number":3,"instruction":"锅中补入剩余油，放番茄和剩余盐，中火炒到边缘变软并出现红色汤汁。","ingredientNames":["食用油","西红柿","盐"],"durationSecondsMin":120,"durationSecondsMax":180,"heatOrDevice":"燃气灶中火"},{"number":4,"instruction":"加入白砂糖和炒好的鸡蛋，大火翻匀，让汤汁裹住鸡蛋后立即出锅。","ingredientNames":["糖","鸡蛋"],"durationSecondsMin":20,"durationSecondsMax":40,"heatOrDevice":"燃气灶大火"}]}
{"schemaVersion":1,"sourceKey":"xiaochu:detailed:gongbao-jiding","contentVersion":"2026.08.1","title":"宫保鸡丁","aliases":["宫爆鸡丁"],"summary":"把腌制、兑汁和爆香拆成可观察的步骤，让新手也能做出鸡肉嫩、花生脆、酸甜微辣的宫保鸡丁。","tier":"detailed","difficulty":"medium","servings":3,"prepMinutes":25,"cookMinutes":10,"taste":["酸甜","微辣","咸鲜"],"techniques":["上浆","滑炒","爆香"],"tags":["经典川菜","下饭菜","详细教程"],"cover":{"remoteUrl":"https://images.example.com/recipes/gongbao-jiding.webp","alt":"红亮酱汁包裹鸡丁和花生的宫保鸡丁"},"media":[{"kind":"iframe","url":"https://player.bilibili.com/player.html?bvid=BV1xx411c7mD&page=1&autoplay=1","provider":"bilibili","posterUrl":"https://images.example.com/recipes/gongbao-jiding-video.webp"},{"kind":"external","url":"https://www.example.com/cooking/gongbao-jiding","provider":"参考图文"}],"ingredients":[{"canonicalName":"鸡腿肉","aliases":["去骨鸡腿"],"category":"meat_egg_dairy","quantity":350,"unit":"克","optional":false,"note":"切成一点五厘米见方的鸡丁"},{"canonicalName":"熟花生米","aliases":["花生仁"],"category":"staple","quantity":50,"unit":"克","optional":false},{"canonicalName":"大葱","aliases":["葱白"],"category":"produce","quantity":60,"unit":"克","optional":false,"note":"切一厘米小段"},{"canonicalName":"干辣椒","aliases":[],"category":"seasoning","quantity":6,"unit":"个","optional":false,"note":"剪段并抖去大部分辣椒籽"},{"canonicalName":"花椒","aliases":[],"category":"seasoning","quantity":1,"unit":"克","optional":false},{"canonicalName":"生抽","aliases":[],"category":"seasoning","quantity":15,"unit":"毫升","optional":false},{"canonicalName":"陈醋","aliases":["香醋"],"category":"seasoning","quantity":15,"unit":"毫升","optional":false},{"canonicalName":"白砂糖","aliases":["糖"],"category":"seasoning","quantity":12,"unit":"克","optional":false},{"canonicalName":"玉米淀粉","aliases":["淀粉"],"category":"staple","quantity":8,"unit":"克","optional":false},{"canonicalName":"食用油","aliases":[],"category":"seasoning","quantity":30,"unit":"毫升","optional":false}],"steps":[{"number":1,"instruction":"鸡腿肉切丁后加入五毫升生抽、三克玉米淀粉和五毫升食用油，抓拌到表面发黏并静置。","ingredientNames":["鸡腿肉","生抽","玉米淀粉","食用油"],"durationSecondsMin":600,"durationSecondsMax":900,"heatOrDevice":"无需加热，室温腌制","completionCue":"鸡丁表面均匀发亮，碗底没有游离液体。","commonMistake":"鸡丁大小差异过大，会导致小块变老而大块未熟。","safetyRequirement":"处理生鸡肉后立刻用洗手液洗手，并清洗接触过生肉的刀具和砧板。"},{"number":2,"instruction":"把剩余生抽、陈醋、白砂糖、剩余玉米淀粉和二十毫升清水搅匀，静置前再搅一次防止淀粉沉底。","ingredientNames":["生抽","陈醋","白砂糖","淀粉"],"durationSecondsMin":60,"durationSecondsMax":120,"heatOrDevice":"无需加热，使用小碗调汁","completionCue":"糖基本溶解，料汁颜色均匀且没有明显淀粉团。","commonMistake":"料汁过早倒入锅中或淀粉未搅匀，会出现结块和局部过咸。","safetyRequirement":"盛放料汁的碗和筷子不要接触腌过生鸡肉的容器。"},{"number":3,"instruction":"炒锅充分预热，加入剩余食用油，下鸡丁大火快速摊开并翻炒。","ingredientNames":["食用油","去骨鸡腿"],"durationSecondsMin":90,"durationSecondsMax":150,"heatOrDevice":"燃气灶大火，炒锅","completionCue":"鸡丁所有表面由粉红变白，切开最大一块中心不再透明。","commonMistake":"鸡丁下锅后堆在一起不摊开，会大量出水并失去嫩滑口感。","safetyRequirement":"鸡肉中心必须完全变色且无粉红汁液；不确定时继续加热至中心温度达到七十四摄氏度。"},{"number":4,"instruction":"把鸡丁推到锅边，转中火放入干辣椒和花椒，炒出香气后加入葱白并与鸡丁翻匀。","ingredientNames":["干辣椒","花椒","葱白","鸡腿肉"],"durationSecondsMin":25,"durationSecondsMax":45,"heatOrDevice":"燃气灶中火，炒锅","completionCue":"辣椒颜色变深但没有发黑，能明显闻到花椒和葱香。","commonMistake":"油温过高会让辣椒和花椒迅速焦黑发苦。","safetyRequirement":"辣椒入热油可能刺激呼吸道，保持抽油烟机开启并避免脸靠近锅面。"},{"number":5,"instruction":"料汁再次搅匀后沿锅边倒入，转大火快速翻炒，酱汁变亮并均匀包裹鸡丁时关火，最后拌入熟花生米。","ingredientNames":["陈醋","糖","淀粉","鸡腿肉","熟花生米"],"durationSecondsMin":35,"durationSecondsMax":60,"heatOrDevice":"燃气灶大火，炒锅","completionCue":"锅底没有水样汁液，酱汁薄薄挂在鸡丁表面，花生仍保持干脆。","commonMistake":"花生米放得太早会吸汁变软，料汁收得过久会变得黏稠发糊。","safetyRequirement":"关火后再试味，避免直接品尝滚烫酱汁；对花生过敏者不得加入花生米。"}]}
