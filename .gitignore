runtime/
runtime-copies/
data/runtime/
tmp/uploads/
uploads/tmp/
data/uploads/tmp/

# Imported source content
content/raw/**
!content/raw/.gitkeep

# Playwright artifacts
**/playwright-report/
**/test-results/
**/trace.zip
**/traces/
**/screenshots/

# Local brainstorming companion sessions
.superpowers/

# Isolated feature workspaces
.worktrees/

