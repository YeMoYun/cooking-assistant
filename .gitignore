# Dependencies and package-manager logs
node_modules/
*.log
npm-debug.log*

# Generated output
**/dist/
**/coverage/
playwright-report/
test-results/
reports/

# Local environment files (only redacted examples may be committed)
.env*
!.env.example

# Local databases and SQLite journals
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

