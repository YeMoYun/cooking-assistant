{
  "name": "@xiaochu/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts --vite-development",
    "build": "tsup src/index.ts --format esm --platform node --out-dir dist --sourcemap && copyfiles -u 1 src/db/migrations/*.sql dist/db/migrations",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/multipart": "10.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.3",
    "@xiaochu/shared": "*",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.1",
    "sharp": "0.35.3",
    "undici": "8.10.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "4.1.11",
    "copyfiles": "^2.4.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
